run = "streamlit run app.py --server.port 5000 --server.address 0.0.0.0 --server.headless true"
modules = ["python-3.12"]

[deployment]
run = ["sh", "-c", "pip install -r requirements.txt && streamlit run app.py --server.port 5000 --server.address 0.0.0.0 --server.headless true"]

[[ports]]
localPort = 5000
externalPort = 80
